# psql to vitlamdata_dw through the tunnel, as your personal login
# (RUNBOOK.md, "Connect with psql"), and dbt's dev target (profiles.yml).
# Copy to .env, which is git-ignored, and fill in PGPASSWORD.
PGHOST=127.0.0.1
PGPORT=5433
PGUSER=duc
PGDATABASE=vitlamdata_dw
# Your dev password. dbt cannot prompt for it; psql uses it too and stops asking.
PGPASSWORD=

# dlt (el/): dlt reads env vars named <SECTION>__<KEY>. The warehouse login
# reuses the PG* values above; they expand when this file is sourced
# (set -a; . ./.env). Nightly sets the same names, as loader.
DESTINATION__POSTGRES__CREDENTIALS__HOST=$PGHOST
DESTINATION__POSTGRES__CREDENTIALS__PORT=$PGPORT
DESTINATION__POSTGRES__CREDENTIALS__DATABASE=$PGDATABASE
DESTINATION__POSTGRES__CREDENTIALS__USERNAME=$PGUSER
DESTINATION__POSTGRES__CREDENTIALS__PASSWORD=$PGPASSWORD

# WordPress MariaDB through the tunnel (-L 3306), read-only. Password:
# gcloud secrets versions access latest --secret=dlt-reader-mariadb
SOURCES__WORDPRESS_VITLAMDATA__CREDENTIALS__DRIVERNAME=mysql+pymysql
SOURCES__WORDPRESS_VITLAMDATA__CREDENTIALS__HOST=127.0.0.1
SOURCES__WORDPRESS_VITLAMDATA__CREDENTIALS__PORT=3306
SOURCES__WORDPRESS_VITLAMDATA__CREDENTIALS__DATABASE=wordpress
SOURCES__WORDPRESS_VITLAMDATA__CREDENTIALS__USERNAME=dlt_reader
SOURCES__WORDPRESS_VITLAMDATA__CREDENTIALS__PASSWORD=
