# psql to vitlamdata_dw through the tunnel, as your personal login
# (RUNBOOK.md, "Connect with psql"), and dbt's dev target (profiles.yml).
# Copy to .env, which is git-ignored, and fill in PGPASSWORD.
PGHOST=127.0.0.1
PGPORT=5433
PGUSER=duc
PGDATABASE=vitlamdata_dw
# Your dev password. dbt cannot prompt for it; psql uses it too and stops asking.
PGPASSWORD=

# el/load.py --source wordpress_vitlamdata: the WordPress MariaDB through the
# tunnel (-L 3306:127.0.0.1:3306), as the read-only user dlt_reader. Password:
# gcloud secrets versions access latest --secret=dlt-reader-mariadb
# dlt writes to the warehouse with the PG* vars above.
MARIADB_HOST=127.0.0.1
MARIADB_PORT=3306
MARIADB_USER=dlt_reader
MARIADB_DATABASE=wordpress
MARIADB_PASSWORD=
