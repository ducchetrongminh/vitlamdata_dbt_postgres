# Copy to secrets.toml (git-ignored) and fill in. CI sets the same keys as env
# vars instead, e.g. SOURCES__WORDPRESS_VITLAMDATA__CREDENTIALS__PASSWORD.

# The warehouse through the tunnel (-L 5433). Locally: your personal login, so
# load into your own dataset (RUNBOOK.md). Nightly: loader.
[destination.postgres.credentials]
host = "127.0.0.1"
port = 5433
database = "vitlamdata_dw"
username = "duc"
password = ""

# WordPress MariaDB through the tunnel (-L 3306), read-only.
# Password: gcloud secrets versions access latest --secret=dlt-reader-mariadb
[sources.wordpress_vitlamdata.credentials]
drivername = "mysql+pymysql"
host = "127.0.0.1"
port = 3306
database = "wordpress"
username = "dlt_reader"
password = ""
